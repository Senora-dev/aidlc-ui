{
  "name": "aidlc-ui",
  "version": "0.1.0",
  "description": "A visual companion for AWS AI-DLC workflows. Read-only, local, attaches to your existing AI-DLC installation.",
  "license": "MIT",
  "author": "Shaked Braimok Yosef (Senora)",
  "type": "module",
  "bin": {
    "aidlc-ui": "bin/aidlc-ui.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "demo/",
    "README.md",
    "LICENSE",
    "docs/"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "ai-dlc",
    "aidlc",
    "workflow",
    "visualization",
    "dashboard",
    "local-first"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "dev": "echo 'Run in two terminals: npm run dev:server  and  npm run dev:web (see CONTRIBUTING.md)'",
    "start": "node bin/aidlc-ui.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "compat:upstream": "node scripts/upstream-compat.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "dev:server": "tsx watch src/server/cli.ts --no-open --port 4173 --dev",
    "dev:web": "vite"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "markdown-it": "14.3.3",
    "playwright-core": "1.56.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
